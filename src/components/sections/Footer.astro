---
import { Link } from "@lucide/astro";
import Logo from "@/components/ui/Logo.astro";
import ToTop from "@/components/widgets/ToTop.astro";
import { siteConfig, socialLinks } from "@/config/site.js";

const currentYear = new Date().getFullYear();
const primaryLinks = [
  { name: "Teaching & Coaching", url: "/teaching-coaching/" },
  { name: "Exam Prep", url: "/exam-prep/" },
  { name: "Products", url: "/products/" },
  { name: "Resources", url: "/resources/" },
  { name: "Blog", url: "/blog/" },
  { name: "Contact", url: "/contact/" },
];
---

<footer class="mt-20 border-t border-primary/15 dark:border-primary-light/15">
  <div class="site-container py-12 md:py-16">
    <div class="grid gap-10 sm:grid-cols-2 lg:grid-cols-[1.2fr_1fr_1fr]">
      <div>
        <Logo />
        <p class="mt-4 max-w-xs text-sm leading-6 text-neutral-600 dark:text-neutral-300">{siteConfig.description}</p>
        <div class="mt-5 flex flex-wrap gap-3">
          {socialLinks.map(({ name, url }) => {
            return <a href={url} target="_blank" rel="noopener noreferrer" aria-label={`PrepNAce on ${name}`} class="inline-flex items-center gap-1.5 text-xs text-neutral-500 hover:text-primary dark:text-neutral-400 dark:hover:text-primary-light"><Link size={16} /><span>{name[0].toUpperCase() + name.slice(1)}</span></a>;
          })}
        </div>
      </div>
      <div>
        <h2 class="mb-4 text-sm font-semibold text-neutral-800 dark:text-neutral-100">Explore</h2>
        <ul class="space-y-3">{primaryLinks.map((link) => <li><a href={link.url} class="text-sm text-neutral-600 hover:text-primary dark:text-neutral-300 dark:hover:text-primary-light">{link.name}</a></li>)}</ul>
      </div>
      <div>
        <h2 class="mb-4 text-sm font-semibold text-neutral-800 dark:text-neutral-100">Products</h2>
        <ul class="space-y-3">{siteConfig.products.map((product) => { const url = product.status === "available" && product.url ? product.url : `/products/${product.slug}/`; return <li><a href={url} target={url.startsWith("http") ? "_blank" : undefined} rel={url.startsWith("http") ? "noopener noreferrer" : undefined} class="text-sm text-neutral-600 hover:text-primary dark:text-neutral-300 dark:hover:text-primary-light">{product.name}</a></li>; })}</ul>
      </div>
    </div>
    <div class="mt-10 flex flex-col gap-3 border-t border-neutral-200 pt-6 text-sm text-neutral-500 dark:border-neutral-700 dark:text-neutral-400 sm:flex-row sm:items-center sm:justify-between">
      <p>© {currentYear} PrepNAce. All rights reserved.</p>
      <p>{siteConfig.tagline}</p>
    </div>
  </div>
</footer>
<ToTop />
