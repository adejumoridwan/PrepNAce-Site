---
import { ArrowLeft, Construction } from "@lucide/astro";

interface Props {
  name: string;
  description: string;
  returnUrl?: string;
}

const { name, description, returnUrl = "/" } = Astro.props;
---

<section class="site-container flex min-h-[55vh] items-center justify-center py-16">
  <div class="w-full max-w-xl border border-neutral-200 bg-white p-7 text-center dark:border-neutral-700 dark:bg-bg-secondary-dark sm:p-10">
    <span class="mx-auto flex h-12 w-12 items-center justify-center border border-accent/70 text-primary dark:text-primary-light"><Construction size={22} /></span>
    <p class="mt-5 text-xs font-semibold uppercase tracking-[0.12em] text-primary dark:text-primary-light">Coming Soon</p>
    <h1 class="mt-2 font-brand text-4xl text-neutral-900 dark:text-white">{name}</h1>
    <p class="mx-auto mt-4 max-w-md text-sm leading-7 text-neutral-600 dark:text-neutral-300">{description}</p>
    <p class="mt-5 font-medium text-neutral-700 dark:text-neutral-200">Still building, Come back later.</p>
    <a href={returnUrl} class="mt-7 inline-flex items-center gap-2 rounded-md bg-primary px-5 py-3 text-sm font-semibold text-white hover:bg-primary-strong"><ArrowLeft size={16} /> Return to Home</a>
  </div>
</section>
