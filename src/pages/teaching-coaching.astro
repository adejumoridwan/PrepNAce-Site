---
import { ArrowRight, BookOpenCheck, CalendarDays, Compass, GraduationCap, Lightbulb, Users } from "@lucide/astro";
import Layout from "@/layouts/Layout.astro";

const services = [
  { title: "Academic Teaching", text: "Clear, practical lessons that help students understand core ideas and apply what they learn.", icon: GraduationCap },
  { title: "Exam Coaching", text: "Structured preparation, practice routines and review for school and entrance examinations.", icon: BookOpenCheck },
  { title: "Study Skills", text: "Build effective habits for focus, revision, note-making and independent learning.", icon: Lightbulb },
  { title: "Academic Planning", text: "Make informed choices and shape a practical plan for the next stage of learning.", icon: CalendarDays },
  { title: "Student Mentorship", text: "Supportive guidance that helps learners set goals and follow through with confidence.", icon: Users },
  { title: "Digital & Technical Skills", text: "Explore useful capabilities that complement school learning and open new paths.", icon: Compass },
];
---

<Layout title="Teaching & Coaching | PrepNAce" description="Practical teaching, academic support and student coaching to help learners understand, prepare and grow.">
  <main class="site-container py-14 md:py-20">
    <header class="max-w-3xl border-l-2 border-accent pl-6"><p class="text-xs font-semibold uppercase tracking-[0.12em] text-primary dark:text-primary-light">Teaching & Coaching</p><h1 class="mt-3 font-brand text-5xl leading-tight text-neutral-900 dark:text-white">Learn with purpose. Prepare with confidence.</h1><p class="mt-5 text-base leading-8 text-neutral-600 dark:text-neutral-300">PrepNAce provides practical teaching, academic support and coaching designed to help students understand what they learn, prepare effectively and develop better learning habits.</p></header>
    <section class="mt-14 grid gap-4 sm:grid-cols-2 lg:grid-cols-3" aria-label="Teaching and coaching services">{services.map(({ title, text, icon: Icon }) => <article class="border border-neutral-200 bg-white p-5 dark:border-neutral-700 dark:bg-bg-secondary-dark"><Icon size={23} class="text-primary dark:text-primary-light" /><h2 class="mt-5 font-semibold text-neutral-900 dark:text-white">{title}</h2><p class="mt-2 text-sm leading-6 text-neutral-600 dark:text-neutral-300">{text}</p></article>)}</section>
    <section class="mt-14 flex flex-col items-start justify-between gap-5 border-y border-primary/15 py-8 sm:flex-row sm:items-center"><div><h2 class="font-brand text-3xl text-neutral-900 dark:text-white">Ready to take your next step?</h2><p class="mt-2 text-sm text-neutral-600 dark:text-neutral-300">Get in touch to ask about learning support from PrepNAce.</p></div><a href="/contact/" class="inline-flex items-center gap-2 rounded-md bg-primary px-5 py-3 text-sm font-semibold text-white">Contact PrepNAce <ArrowRight size={16} /></a></section>
  </main>
</Layout>
