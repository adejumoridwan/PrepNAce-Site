---
import { BookOpen, Compass, GraduationCap, Layers, Lightbulb, Users } from "@lucide/astro";
import Layout from "@/layouts/Layout.astro";
import { siteConfig } from "@/config/site.js";

const pillars = [
  { title: "Teaching & Coaching", icon: GraduationCap },
  { title: "Exam Preparation", icon: BookOpen },
  { title: "Learning Resources", icon: Layers },
  { title: "Student Opportunities", icon: Compass },
  { title: "Software Products", icon: Lightbulb },
  { title: "Skills & Growth", icon: Users },
];
---

<Layout title="About PrepNAce | Academic Excellence & Success" description={siteConfig.description}>
  <main class="site-container py-14 md:py-20">
    <header class="max-w-3xl border-l-2 border-accent pl-6"><p class="text-xs font-semibold uppercase tracking-[0.12em] text-primary dark:text-primary-light">About PrepNAce</p><h1 class="mt-3 font-brand text-5xl leading-tight text-neutral-900 dark:text-white">Helping students learn, prepare, grow and succeed.</h1><p class="mt-5 text-base leading-8 text-neutral-600 dark:text-neutral-300">PrepNAce is an education and student-development platform focused on helping learners build knowledge, prepare for examinations, develop useful skills and achieve academic success.</p></header>
    <section class="mt-14 max-w-3xl"><h2 class="font-brand text-3xl text-neutral-900 dark:text-white">A growing education ecosystem</h2><p class="mt-4 text-sm leading-7 text-neutral-600 dark:text-neutral-300">Education extends beyond a single examination. PrepNAce brings together practical learning support, exam preparation, useful resources, products and opportunities for student growth.</p></section>
    <section class="mt-12 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">{pillars.map(({ title, icon: Icon }) => <div class="flex items-center gap-3 border border-neutral-200 bg-white p-4 dark:border-neutral-700 dark:bg-bg-secondary-dark"><Icon size={20} class="text-primary dark:text-primary-light" /><span class="text-sm font-medium text-neutral-800 dark:text-neutral-100">{title}</span></div>)}</section>
    <section class="mt-14 border-t border-primary/15 pt-8"><h2 class="font-brand text-3xl text-neutral-900 dark:text-white">The goal</h2><p class="mt-3 max-w-2xl text-sm leading-7 text-neutral-600 dark:text-neutral-300">To make useful educational support easier to find and to help students build the knowledge, confidence and capabilities they can carry forward.</p><a href="/teaching-coaching/" class="mt-5 inline-block text-sm font-semibold text-primary underline decoration-accent underline-offset-4 dark:text-primary-light">Explore Teaching & Coaching</a></section>
  </main>
</Layout>
