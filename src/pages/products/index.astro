---
import { ArrowRight, BookOpen } from "@lucide/astro";
import Layout from "@/layouts/Layout.astro";
import { siteConfig } from "@/config/site.js";
---

<Layout title="Products | PrepNAce" description="Explore PrepNAce products for learning, study, skills and student opportunities.">
  <main class="site-container py-14 md:py-20">
    <header class="max-w-3xl"><p class="text-xs font-semibold uppercase tracking-[0.12em] text-primary dark:text-primary-light">PrepNAce products</p><h1 class="mt-3 font-brand text-5xl text-neutral-900 dark:text-white">Products for focused learning and growth</h1><p class="mt-5 text-base leading-8 text-neutral-600 dark:text-neutral-300">Explore PrepNAce products for exam practice, educational materials, practical skills and student opportunities.</p></header>
    <section class="mt-12 grid gap-4 md:grid-cols-3" aria-label="PrepNAce products">{siteConfig.products.map((product) => { const isAvailable = product.status === "available"; const url = isAvailable ? product.url : `/products/${product.slug}/`; return <article class="flex min-h-64 flex-col border border-neutral-200 bg-white p-6 dark:border-neutral-700 dark:bg-bg-secondary-dark"><div class="flex items-center justify-between"><BookOpen class="text-primary dark:text-primary-light" size={22} /><span class={`border px-2 py-1 text-xs font-medium ${isAvailable ? "border-primary/30 text-primary dark:text-primary-light" : "border-accent/70 text-neutral-700 dark:text-accent-light"}`}>{isAvailable ? "Available" : "Coming Soon"}</span></div><h2 class="mt-6 text-lg font-semibold text-neutral-900 dark:text-white">{product.name}</h2><p class="mt-2 flex-1 text-sm leading-6 text-neutral-600 dark:text-neutral-300">{product.description}</p>{isAvailable ? <a href={url} target={url.startsWith("http") ? "_blank" : undefined} rel={url.startsWith("http") ? "noopener noreferrer" : undefined} class="mt-5 inline-flex items-center gap-2 text-sm font-semibold text-primary dark:text-primary-light">Explore Product <ArrowRight size={15} /></a> : <div class="mt-5"><p class="text-sm font-medium text-neutral-700 dark:text-neutral-200">Still building, Come back later.</p><a href={url} class="mt-2 inline-block text-xs font-semibold text-primary underline underline-offset-4 dark:text-primary-light">Coming Soon details</a></div>}</article>; })}</section>
  </main>
</Layout>
