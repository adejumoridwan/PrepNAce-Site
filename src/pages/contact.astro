---
import { ArrowRight, Link, Mail, Send, Sparkles } from "@lucide/astro";
import Layout from "@/layouts/Layout.astro";
import { siteConfig } from "@/config/site.js";

const socials = Object.entries(siteConfig.social).filter(([, url]) => Boolean(url));
const formspreeEndpoint = (import.meta.env.PUBLIC_FORMSPREE_ENDPOINT || "").trim();
---

<Layout title="Contact PrepNAce" description="Contact PrepNAce about learning support, exam preparation, resources and partnerships.">
  <main class="site-container py-14 md:py-20">
    <div class="grid gap-12 lg:grid-cols-[0.9fr_1.1fr]">
      <section>
        <p class="inline-flex items-center gap-2 border-l-2 border-accent pl-3 text-xs font-semibold uppercase tracking-[0.12em] text-primary dark:text-primary-light"><Sparkles size={14} /> Contact</p>
        <h1 class="mt-4 max-w-xl font-brand text-5xl leading-tight text-neutral-900 dark:text-white">Let’s talk about your learning goals.</h1>
        <p class="mt-5 max-w-lg text-base leading-8 text-neutral-600 dark:text-neutral-300">Contact PrepNAce with general enquiries about teaching, exam preparation, study resources, products or partnerships.</p>
        <a href={`mailto:${siteConfig.contact.email}`} class="mt-8 flex max-w-md items-center gap-4 border border-neutral-200 bg-white p-4 hover:border-primary/35 dark:border-neutral-700 dark:bg-bg-secondary-dark"><span class="flex h-10 w-10 items-center justify-center bg-primary/5 text-primary dark:text-primary-light"><Mail size={19} /></span><span><span class="block text-xs text-neutral-500 dark:text-neutral-400">Email</span><span class="mt-1 block text-sm font-semibold text-neutral-800 dark:text-neutral-100">{siteConfig.contact.email}</span></span><ArrowRight class="ml-auto text-neutral-400" size={16} /></a>
        {siteConfig.contact.phone && <a href={`tel:${siteConfig.contact.phone}`} class="mt-3 block text-sm text-primary underline dark:text-primary-light">{siteConfig.contact.phone}</a>}
        {siteConfig.contact.whatsapp && <a href={siteConfig.contact.whatsapp} target="_blank" rel="noopener noreferrer" class="mt-3 block text-sm text-primary underline dark:text-primary-light">Contact PrepNAce on WhatsApp</a>}
        {socials.length > 0 && <div class="mt-8"><h2 class="text-sm font-semibold text-neutral-900 dark:text-white">Social media</h2><ul class="mt-3 flex flex-wrap gap-3">{socials.map(([name, url]) => <li><a href={url} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 border border-neutral-200 px-3 py-2 text-sm text-neutral-700 hover:border-primary dark:border-neutral-700 dark:text-neutral-200"><Link size={15} />{name[0].toUpperCase() + name.slice(1)}</a></li>)}</ul></div>}
      </section>
      <section class="border border-neutral-200 bg-white p-5 dark:border-neutral-700 dark:bg-bg-secondary-dark sm:p-8">
        <p class="text-xs font-semibold uppercase tracking-[0.12em] text-primary dark:text-primary-light">General Enquiries</p><h2 class="mt-2 font-brand text-3xl text-neutral-900 dark:text-white">Send a message</h2><p class="mt-3 text-sm leading-6 text-neutral-600 dark:text-neutral-300">{formspreeEndpoint ? "Your message will be sent directly to PrepNAce." : "Submitting opens a prefilled draft in your default email app. You can review and send it there."}</p>
        <form id="contact-form" data-endpoint={formspreeEndpoint} data-email={siteConfig.contact.email} class="mt-7 space-y-5">
          <input type="text" name="_gotcha" class="hidden" tabindex="-1" autocomplete="off" aria-hidden="true" />
          <div class="grid gap-5 sm:grid-cols-2"><div><label for="name" class="mb-2 block text-sm font-medium text-neutral-700 dark:text-neutral-200">Name</label><input id="name" name="name" autocomplete="name" required class="contact-field" /></div><div><label for="email" class="mb-2 block text-sm font-medium text-neutral-700 dark:text-neutral-200">Email</label><input id="email" name="email" type="email" autocomplete="email" required class="contact-field" /></div></div>
          <div><label for="subject" class="mb-2 block text-sm font-medium text-neutral-700 dark:text-neutral-200">Subject</label><select id="subject" name="subject" required class="contact-field"><option value="">Choose a topic</option><option>Teaching & Coaching</option><option>Exam Preparation</option><option>Learning Resources</option><option>Products</option><option>Partnership</option><option>General Enquiry</option></select></div>
          <div><label for="message" class="mb-2 block text-sm font-medium text-neutral-700 dark:text-neutral-200">Message</label><textarea id="message" name="message" rows="5" required class="contact-field"></textarea></div>
          <button id="contact-submit" type="submit" aria-busy="false" class="inline-flex items-center gap-2 rounded-md bg-primary px-5 py-3 text-sm font-semibold text-white hover:bg-primary-strong disabled:cursor-wait disabled:opacity-60"><span id="contact-submit-label">{formspreeEndpoint ? "Send Message" : "Open Email Draft"}</span><Send size={15} /></button>
          <p id="contact-status" class="hidden text-sm" role="status" aria-live="polite"></p>
        </form>
      </section>
    </div>
  </main>
</Layout>

<style>
  .contact-field { width: 100%; border: 1px solid var(--color-neutral-300); background: var(--color-bg-secondary); padding: 0.75rem 0.875rem; color: var(--color-neutral-800); outline: none; }
  .contact-field:focus { border-color: var(--color-primary); box-shadow: 0 0 0 3px color-mix(in srgb, var(--color-primary) 20%, transparent); }
  :global(.dark) .contact-field { border-color: var(--color-neutral-700); background: var(--color-bg-primary-dark); color: var(--color-neutral-100); }
</style>

<script>
  const form = document.querySelector<HTMLFormElement>("#contact-form");
  const status = document.querySelector<HTMLElement>("#contact-status");
  const submitButton = document.querySelector<HTMLButtonElement>("#contact-submit");
  const submitLabel = document.querySelector<HTMLElement>("#contact-submit-label");
  const contactEmail = form?.dataset.email || "";

  function showStatus(message: string, isError = false) {
    if (!status) return;
    status.textContent = message;
    status.classList.toggle("hidden", !message);
    status.classList.toggle("text-red-700", isError);
    status.classList.toggle("dark:text-red-300", isError);
    status.classList.toggle("text-primary", !isError);
    status.classList.toggle("dark:text-primary-light", !isError);
  }

  form?.addEventListener("submit", async (event) => {
    event.preventDefault();
    if (!form.reportValidity()) return;

    const endpoint = form.dataset.endpoint;
    if (!endpoint) {
      const data = new FormData(form);
      const subject = encodeURIComponent(`[PrepNAce] ${data.get("subject")}`);
      const body = encodeURIComponent(`Name: ${data.get("name")}\nEmail: ${data.get("email")}\n\n${data.get("message")}`);
      window.location.href = `mailto:${contactEmail}?subject=${subject}&body=${body}`;
      return;
    }

    showStatus("");
    submitButton!.disabled = true;
    submitButton!.setAttribute("aria-busy", "true");
    submitLabel!.textContent = "Sending...";

    try {
      const response = await fetch(endpoint, {
        method: "POST",
        body: new FormData(form),
        headers: { Accept: "application/json" },
      });
      if (!response.ok) throw new Error("Formspree submission failed");
      form.reset();
      showStatus("Thanks. Your message has been sent.");
    } catch {
      showStatus(`We could not send your message. Please try again or email ${contactEmail}.`, true);
    } finally {
      submitButton!.disabled = false;
      submitButton!.setAttribute("aria-busy", "false");
      submitLabel!.textContent = "Send Message";
    }
  });
</script>