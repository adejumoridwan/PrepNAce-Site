---
import { ArrowLeft, BookOpen, Compass } from "@lucide/astro";
import PageLayout from "@/layouts/PageLayout.astro";
---

<PageLayout title="Page Not Found | PrepNAce" description="The page may have moved or is still being built.">
  <main class="site-container flex min-h-[65vh] items-center py-16">
    <section class="max-w-2xl border-l-2 border-accent pl-6">
      <p class="text-xs font-semibold uppercase tracking-[0.12em] text-primary dark:text-primary-light">404 · PrepNAce</p>
      <h1 class="mt-4 font-brand text-5xl text-neutral-900 dark:text-white">Page not found.</h1>
      <p class="mt-5 text-base leading-8 text-neutral-600 dark:text-neutral-300">The page you're looking for may have moved or is still being built.</p>
      <div class="mt-7 flex flex-wrap gap-3"><a href="/" class="inline-flex items-center gap-2 rounded-md bg-primary px-5 py-3 text-sm font-semibold text-white"><ArrowLeft size={16} /> Go Home</a><a href="/resources/" class="inline-flex items-center gap-2 border border-primary/25 px-5 py-3 text-sm font-semibold text-primary dark:text-primary-light"><BookOpen size={16} /> Explore Resources</a></div>
      <p class="mt-8 inline-flex items-center gap-2 text-sm text-neutral-500 dark:text-neutral-400"><Compass size={16} /> Academic Excellence &amp; Success</p>
    </section>
  </main>
</PageLayout>
