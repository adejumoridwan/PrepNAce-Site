---
import { getCollection } from "astro:content";
import { ArrowRight, BookOpen, Brain, Compass, GraduationCap, NotebookTabs } from "@lucide/astro";
import Layout from "@/layouts/Layout.astro";
import { siteConfig } from "@/config/site.js";
import { resources } from "@/data/resources.js";

const posts = (await getCollection("post")).sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf()).slice(0, 3);
const offers = [
  { title: "Teaching & Coaching", description: "Learn with practical, clear and student-focused instruction.", icon: GraduationCap, href: "/teaching-coaching/" },
  { title: "Exam Preparation", description: "Prepare for JAMB, WAEC, NECO and other examinations with structured practice and resources.", icon: BookOpen, href: "/exam-prep/" },
  { title: "Learning Resources", description: "Access useful study materials organized by subject and topic.", icon: NotebookTabs, href: "/resources/" },
  { title: "Student Opportunities", description: "Discover useful opportunities, programs and resources for students and young people.", icon: Compass, href: "/products/opportunity/", status: "Coming Soon" },
  { title: "Skills & Growth", description: "Develop practical skills that go beyond the classroom.", icon: Brain, href: "/teaching-coaching/", status: "Growing area" },
];
---

<Layout title="PrepNAce | Academic Excellence & Success" description={siteConfig.description}>
  <main>
    <section class="relative overflow-hidden border-b border-primary/10 bg-[linear-gradient(115deg,#f7faf6_0%,#fff_55%,#f4f6e9_100%)] dark:bg-[linear-gradient(115deg,#091b14_0%,#10271d_55%,#18281a_100%)]">
      <div class="site-container relative grid min-h-[580px] items-center gap-12 py-20 md:grid-cols-[1.1fr_0.9fr] md:py-28">
        <div class="max-w-2xl" data-aos="fade-up-xs" data-aos-once="true">
          <p class="mb-5 inline-flex items-center gap-2 border-l-2 border-accent pl-3 text-xs font-semibold uppercase tracking-[0.12em] text-primary dark:text-primary-light">{siteConfig.tagline}</p>
          <h1 class="font-brand text-5xl leading-[1.02] text-neutral-900 dark:text-white sm:text-6xl lg:text-7xl">Learn. Prepare.<br /><span class="text-primary dark:text-primary-light">Grow. Succeed.</span></h1>
          <p class="mt-6 max-w-xl text-lg leading-8 text-neutral-600 dark:text-neutral-300">PrepNAce helps students build knowledge, prepare for examinations, develop useful skills and achieve their academic goals.</p>
          <div class="mt-8 flex flex-wrap gap-3">
            <a href="/exam-prep/" class="inline-flex items-center gap-2 rounded-md bg-primary px-5 py-3 text-sm font-semibold text-white transition hover:bg-primary-strong focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary">Explore Exam Prep <ArrowRight size={16} /></a>
            <a href="/teaching-coaching/" class="inline-flex items-center rounded-md border border-primary/25 px-5 py-3 text-sm font-semibold text-primary transition hover:bg-primary/5 dark:text-primary-light">Teaching & Coaching</a>
            <a href="/products/" class="px-2 py-3 text-sm font-semibold text-neutral-700 underline decoration-accent decoration-2 underline-offset-4 hover:text-primary dark:text-neutral-200">Explore Products</a>
          </div>
        </div>
        <div class="relative mx-auto w-full max-w-md" aria-label="Learning, practice and progress" data-aos="fade-up-xs" data-aos-delay="120" data-aos-once="true">
          <div class="absolute -right-4 -top-4 h-24 w-24 border-r-2 border-t-2 border-accent/80"></div>
          <div class="relative border border-primary/15 bg-white p-6 shadow-[0_24px_70px_rgba(17,67,46,0.12)] dark:border-primary-light/20 dark:bg-bg-secondary-dark sm:p-8">
            <div class="flex items-center justify-between border-b border-dashed border-neutral-200 pb-5 dark:border-neutral-700"><span class="text-sm font-semibold text-primary dark:text-primary-light">Your learning journey</span><BookOpen class="text-accent" size={21} /></div>
            <div class="space-y-5 py-6">
              {[
                { number: "01", title: "Build understanding", text: "Clear teaching and useful study resources" },
                { number: "02", title: "Prepare with purpose", text: "Practice, review and see your progress" },
                { number: "03", title: "Grow beyond the classroom", text: "Develop habits and skills for what comes next" },
              ].map((step) => <div class="flex gap-4"><span class="font-brand text-2xl text-accent">{step.number}</span><div><h2 class="text-sm font-semibold text-neutral-800 dark:text-neutral-100">{step.title}</h2><p class="mt-1 text-sm leading-6 text-neutral-500 dark:text-neutral-400">{step.text}</p></div></div>)}
            </div>
            <div class="flex items-center gap-2 border-t border-dashed border-neutral-200 pt-4 text-xs font-medium text-neutral-500 dark:border-neutral-700 dark:text-neutral-400"><span class="h-2 w-2 rounded-full bg-primary"></span>Learn · prepare · grow · succeed</div>
          </div>
          <div class="absolute -bottom-4 -left-4 h-14 w-14 border-b-2 border-l-2 border-primary/50"></div>
        </div>
      </div>
    </section>

    <section class="site-container py-16 md:py-24">
      <div class="mb-10 flex flex-col gap-3 md:flex-row md:items-end md:justify-between"><div><p class="text-xs font-semibold uppercase tracking-[0.12em] text-primary dark:text-primary-light">The PrepNAce ecosystem</p><h2 class="mt-2 font-brand text-4xl text-neutral-900 dark:text-white">What PrepNAce Offers</h2></div><p class="max-w-lg text-sm leading-7 text-neutral-600 dark:text-neutral-300">A growing education community supporting the whole student journey, from learning fundamentals to planning what comes next.</p></div>
      <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {offers.map(({ title, description, icon: Icon, href, status }) => <a href={href} class="group border border-neutral-200 bg-white p-5 transition hover:border-primary/35 hover:shadow-[0_12px_32px_rgba(17,67,46,0.08)] dark:border-neutral-700 dark:bg-bg-secondary-dark"><div class="flex items-center justify-between gap-2"><Icon class="text-primary dark:text-primary-light" size={23} />{status && <span class="border border-accent/70 px-2 py-1 text-[10px] font-medium text-neutral-700 dark:text-accent-light">{status}</span>}</div><h3 class="mt-5 text-base font-semibold text-neutral-900 dark:text-white">{title}</h3><p class="mt-2 text-sm leading-6 text-neutral-600 dark:text-neutral-300">{description}</p>{status === "Coming Soon" ? <span class="mt-4 block text-xs text-neutral-500 dark:text-neutral-400">Still building, Come back later.</span> : <span class="mt-4 inline-flex items-center gap-1 text-sm font-semibold text-primary group-hover:gap-2 dark:text-primary-light">Explore <ArrowRight size={15} /></span>}</a>)}
      </div>
    </section>

    <section class="bg-[#eef4ee] py-16 dark:bg-[#10271d] md:py-20">
      <div class="site-container grid items-center gap-10 md:grid-cols-[1fr_0.9fr]">
        <div><p class="text-xs font-semibold uppercase tracking-[0.12em] text-primary dark:text-primary-light">Available now</p><h2 class="mt-3 max-w-xl font-brand text-4xl leading-tight text-neutral-900 dark:text-white">Practice with purpose in the PrepNAce Mobile App</h2><p class="mt-4 max-w-xl text-base leading-7 text-neutral-600 dark:text-neutral-300">Build confidence for CBT examinations with focused past-question practice, study tools and performance insights.</p><ul class="mt-6 grid gap-3 text-sm text-neutral-700 dark:text-neutral-200 sm:grid-cols-2">{["Practice past questions", "Study by subject and topic", "Identify weaker areas", "Track your performance", "Prepare for CBT examinations"].map((item) => <li class="flex items-center gap-2"><span class="h-1.5 w-1.5 rounded-full bg-accent"></span>{item}</li>)}</ul><a href={siteConfig.products[0].url} class="mt-7 inline-flex items-center gap-2 font-semibold text-primary hover:underline dark:text-primary-light">Explore PrepNAce App <ArrowRight size={16} /></a></div>
        <div class="relative mx-auto w-full max-w-sm border border-primary/15 bg-white p-6 dark:border-primary-light/20 dark:bg-bg-secondary-dark"><div class="flex items-center gap-3 border-b border-neutral-200 pb-4 dark:border-neutral-700"><div class="flex h-11 w-11 items-center justify-center bg-primary text-white"><BookOpen size={21} /></div><div><p class="text-sm font-semibold text-neutral-900 dark:text-white">PrepNAce Mobile App</p><p class="text-xs text-neutral-500 dark:text-neutral-400">JAMB · WAEC · NECO</p></div></div><div class="mt-5 space-y-3">{["Mathematics", "English Language", "Biology"].map((subject, index) => <div class="flex items-center justify-between border border-neutral-200 px-3 py-3 dark:border-neutral-700"><span class="text-sm text-neutral-700 dark:text-neutral-200">{subject}</span><span class="h-1.5 w-20 bg-neutral-100 dark:bg-neutral-700"><span class="block h-full bg-primary" style={`width:${[72, 58, 84][index]}%`}></span></span></div>)}</div><p class="mt-4 text-xs text-neutral-500 dark:text-neutral-400">Study at your pace. Learn from every attempt.</p></div>
      </div>
    </section>

    <section class="site-container grid gap-8 py-16 md:grid-cols-2 md:py-24">
      <div class="border-l-2 border-accent pl-6"><p class="text-xs font-semibold uppercase tracking-[0.12em] text-primary dark:text-primary-light">Learning that lasts</p><h2 class="mt-3 font-brand text-4xl text-neutral-900 dark:text-white">More Than Exam Preparation</h2><p class="mt-4 text-sm leading-7 text-neutral-600 dark:text-neutral-300">PrepNAce helps students understand what they learn, build better study habits, prepare for examinations, plan their academic journey and develop useful skills.</p><a href="/teaching-coaching/" class="mt-5 inline-flex items-center gap-2 text-sm font-semibold text-primary dark:text-primary-light">Explore Teaching & Coaching <ArrowRight size={16} /></a></div>
      <div class="border-l border-neutral-200 pl-6 dark:border-neutral-700"><p class="text-xs font-semibold uppercase tracking-[0.12em] text-primary dark:text-primary-light">Study library</p><h2 class="mt-3 font-brand text-3xl text-neutral-900 dark:text-white">Learning Resources</h2>{resources.slice(0, 2).map((resource) => <a href={`/resources/${resource.slug}/`} class="mt-4 block border-b border-neutral-200 py-3 dark:border-neutral-700"><span class="text-xs text-neutral-500">{resource.subject} · {resource.topic} · PDF</span><span class="mt-1 block font-semibold text-neutral-800 dark:text-neutral-100">{resource.title}</span></a>)}{resources.length === 0 && <p class="mt-4 text-sm leading-6 text-neutral-600 dark:text-neutral-300">New study materials are being prepared. Browse by subject and topic as the library grows.</p>}<a href="/resources/" class="mt-4 inline-flex items-center gap-2 text-sm font-semibold text-primary dark:text-primary-light">Browse All Resources <ArrowRight size={16} /></a></div>
    </section>

    <section class="bg-white py-16 dark:bg-bg-secondary-dark md:py-20"><div class="site-container"><div class="mb-8 flex items-end justify-between gap-4"><div><p class="text-xs font-semibold uppercase tracking-[0.12em] text-primary dark:text-primary-light">PrepNAce products</p><h2 class="mt-2 font-brand text-4xl text-neutral-900 dark:text-white">Tools for your learning</h2></div><a href="/products/" class="hidden items-center gap-2 text-sm font-semibold text-primary sm:inline-flex dark:text-primary-light">Explore Products <ArrowRight size={15} /></a></div><div class="grid gap-4 md:grid-cols-3">{siteConfig.products.map((product) => <article class="flex flex-col border border-neutral-200 p-5 dark:border-neutral-700"><div class="flex items-start justify-between gap-3"><h3 class="font-semibold text-neutral-900 dark:text-white">{product.name}</h3><span class={`shrink-0 border px-2 py-1 text-[11px] font-medium ${product.status === "available" ? "border-primary/25 text-primary dark:text-primary-light" : "border-accent/70 text-neutral-700 dark:text-accent-light"}`}>{product.status === "available" ? "Available" : "Coming Soon"}</span></div><p class="mt-3 flex-1 text-sm leading-6 text-neutral-600 dark:text-neutral-300">{product.description}</p>{product.status === "available" ? <a href={product.url} class="mt-5 inline-flex items-center gap-2 text-sm font-semibold text-primary dark:text-primary-light">Explore Product <ArrowRight size={15} /></a> : <p class="mt-5 text-sm text-neutral-500 dark:text-neutral-400">Still building, Come back later.</p>}</article>)}</div></div></section>

    <section class="site-container pb-16 md:pb-24"><div class="mb-8 flex items-end justify-between gap-4"><div><p class="text-xs font-semibold uppercase tracking-[0.12em] text-primary dark:text-primary-light">Ideas for learners</p><h2 class="mt-2 font-brand text-4xl text-neutral-900 dark:text-white">From the Blog</h2></div><a href="/blog/" class="inline-flex items-center gap-2 text-sm font-semibold text-primary dark:text-primary-light">Read the Blog <ArrowRight size={15} /></a></div>{posts.length ? <div class="grid gap-4 md:grid-cols-3">{posts.map((post) => <a href={`/blog/${post.id}/`} class="border border-neutral-200 p-5 hover:border-primary/35 dark:border-neutral-700"><p class="text-xs text-neutral-500">{post.data.publishDate.toLocaleDateString("en", { dateStyle: "medium" })}</p><h3 class="mt-3 font-semibold text-neutral-900 dark:text-white">{post.data.title}</h3><p class="mt-2 text-sm leading-6 text-neutral-600 dark:text-neutral-300">{post.data.description}</p></a>)}</div> : <p class="text-sm text-neutral-600 dark:text-neutral-300">New articles are on the way.</p>}</section>

    <section class="bg-primary py-14 text-white dark:bg-[#123c2a] md:py-16"><div class="site-container flex flex-col items-start justify-between gap-6 md:flex-row md:items-center"><div><p class="text-xs font-semibold uppercase tracking-[0.12em] text-accent-light">Your next step starts here</p><h2 class="mt-3 max-w-2xl font-brand text-4xl">Build your knowledge. Prepare for your future.</h2><p class="mt-3 max-w-2xl text-sm leading-7 text-white/80">Whether you're preparing for an examination, improving your study habits or developing new skills, PrepNAce is here to help.</p></div><div class="flex shrink-0 flex-wrap gap-3"><a href="/exam-prep/" class="rounded-md bg-accent px-5 py-3 text-sm font-semibold text-neutral-900 hover:bg-accent-light">Start Learning</a><a href="/about/" class="rounded-md border border-white/50 px-5 py-3 text-sm font-semibold text-white hover:bg-white/10">Explore PrepNAce</a></div></div></section>
  </main>
</Layout>
